{
  "name": "@dogfight/server",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Game server: node:http + WebSocket rooms, chat, match logs as streams.",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts | pino-pretty --singleLine --ignore pid,hostname,version",
    "test": "vitest run --root .. --project server",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@dogfight/shared": "*",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
