# Copy to server/.env and adjust. Every value is validated by server/src/config.ts (zod) at
# startup: a typo or a bad value stops the server with a clear message instead of running wrong.
# In production these come from the platform's settings / secret store, never from a file in git.
PORT=8787
# 127.0.0.1 on a laptop; 0.0.0.0 in a container (the Dockerfile sets it), or nobody can reach it.
HOST=127.0.0.1
LOG_DIR=server/logs
STATIC_DIR=client/dist
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
MAX_CONNECTIONS=500
MAX_PAYLOAD_BYTES=4096
JOIN_TIMEOUT_MS=5000
HEARTBEAT_MS=15000
RATE_LIMIT_PER_SEC=10
RATE_LIMIT_BURST=20
# /api/slow, /api/crash and ?naive=1 replays. Never enable in production.
DEBUG_ROUTES=false

# ---- Lab 8: production ----
# fatal | error | warn | info | debug | trace | silent  (JSON lines on stdout)
LOG_LEVEL=info
# Pages allowed to open a WebSocket, comma-separated. Empty = only the page this server serves.
ALLOWED_ORIGINS=
MAX_CONNECTIONS_PER_IP=20
# New WebSocket handshakes per second (and burst) from one address; the excess gets 429.
CONNECT_RATE_PER_IP=5
CONNECT_BURST_PER_IP=20
# true behind a proxy (Fly, Render, nginx): the client address is in X-Forwarded-For.
TRUST_PROXY=false
# SIGTERM: how long clients get to close before they are cut (the platform allows ~10 s total).
SHUTDOWN_GRACE_MS=3000
# Set by the build (docker build --build-arg GIT_SHA=…); shown in /health and the HUD.
GIT_SHA=dev
