{
  "name": "dogfight",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Top-down 2D arena game built step by step for the JavaScript course (labs 1-8).",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "vitest run",
    "typecheck": "tsc -p . && npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.3",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
