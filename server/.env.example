# Copy to server/.env and adjust. Every value is validated by server/src/config.js.
PORT=8787
HOST=127.0.0.1
LOG_DIR=server/logs
STATIC_DIR=client/dist
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
MAX_PAYLOAD_BYTES=4096
JOIN_TIMEOUT_MS=5000
HEARTBEAT_MS=15000
RATE_LIMIT_PER_SEC=10
RATE_LIMIT_BURST=20
# /api/slow (event-loop blocking demo) and ?naive=1 replays. Never enable in production.
DEBUG_ROUTES=false
