{
  "extends": "../tsconfig.base.json",
  // The browser app (DOM) + its Node-side tests and scripts. Vite transpiles .ts without
  // checking; `npm run typecheck` (tsc) is what checks, locally and in CI.
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
